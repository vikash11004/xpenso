rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function amount(n) { return n is int && n > 0 && n <= 100000000; }
    function short(s,n) { return s is string && s.size() <= n; }
    match /users/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid) && request.resource.data.keys().hasOnly(['displayName','email','currency','timezone','createdAt','onboardingVersion'])
        && request.resource.data.currency == 'INR' && request.resource.data.timezone == 'Asia/Kolkata'
        && short(request.resource.data.displayName,60) && short(request.resource.data.email,254);
      allow update: if owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','onboardingVersion','schemaVersion','migrationSkipped'])
        && short(request.resource.data.displayName,60);
      match /caps/{id} {
        allow read: if owner(uid);
        allow create,update: if owner(uid) && request.resource.data.keys().hasOnly(['id','name','icon','limitMinor','tone','active','startedOn'])
          && request.resource.data.id == id
          && short(request.resource.data.name,60) && short(request.resource.data.icon,12)
          && request.resource.data.name.size()>0 && amount(request.resource.data.limitMinor)
          && request.resource.data.active is bool && request.resource.data.startedOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.tone in ['sage','peach','blue','lavender'];
      }
      match /capMonths/{id} {
        allow read: if owner(uid);
        function validPeriod() {
          let d=request.resource.data;
          return d.keys().hasOnly(['capId','monthKey','originalLimitMinor','effectiveLimitMinor','flexed'])
            && short(d.capId,100) && d.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
            && id == d.monthKey + '_' + d.capId && amount(d.originalLimitMinor) && amount(d.effectiveLimitMinor) && d.flexed is bool;
        }
        allow create: if owner(uid) && validPeriod();
        allow update: if owner(uid) && validPeriod() && request.resource.data.originalLimitMinor == resource.data.originalLimitMinor;
      }
      match /expenses/{id} {
        allow read: if owner(uid);
        allow create,update: if owner(uid)
          && request.resource.data.keys().hasOnly(['amountMinor','merchant','capId','occurredOn','monthKey','currency','source','receiptHash','deleted','schemaVersion','createdAt','updatedAt','legacyId','legacyCategory'])
          && amount(request.resource.data.amountMinor) && request.resource.data.currency=='INR'
          && short(request.resource.data.merchant,120) && request.resource.data.merchant.size()>0
          && short(request.resource.data.capId,100)
          && request.resource.data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
          && request.resource.data.occurredOn.matches(request.resource.data.monthKey + '-[0-9]{2}')
          && request.resource.data.source in ['manual','text','receipt','migration']
          && short(request.resource.data.receiptHash,64) && request.resource.data.deleted is bool
          && request.resource.data.schemaVersion==2;
      }
      // Read-only legacy records permit repeatable migration without deleting history.
      match /transactions/{id} { allow read: if owner(uid); }
      match /budgetCategories/{id} { allow read: if owner(uid); }
    }
    // Usage counters and all other collections are server-only by default.
  }
}
